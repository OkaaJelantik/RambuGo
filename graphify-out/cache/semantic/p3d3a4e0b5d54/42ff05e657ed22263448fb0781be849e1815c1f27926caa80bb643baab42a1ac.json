{"nodes": [{"id": "product_petualangan_rambu", "label": "Petualangan Rambu Lalu Lintas", "file_type": "document", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aplikasi web interaktif tanpa backend untuk anak kelas II SD; React 19 + Vite 8 + TypeScript 7, semua gambar SVG inline, berjalan di localhost."}, {"id": "product_audiens", "label": "Audiens: Anak Kelas II SD", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anak 7-8 tahun memegang HP sendiri, dipandu orang tua/guru; bahasa Indonesia register anak ('aku', bukan 'anda'); kalimat per beat <= 90 karakter dan <= 2 kalimat; HP 360 px lebih dulu; satu anak per layar tanpa akun."}, {"id": "product_tujuan_belajar", "label": "Tujuan Belajar: Bentuk + Warna Dulu", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rambu diajarkan sebagai daftar hafalan sehingga anak lupa karena tidak ada yang menghubungkan bentuk dengan makna. Kalau anak bisa berkata 'segitiga kuning berarti ada yang harus kuhindari', tujuan sudah tercapai tanpa menghafal keenam nama."}, {"id": "product_bentuk_warna", "label": "Taksonomi Bentuk + Warna", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empat pasangan: segitiga kuning = peringatan, bulat merah = larangan, bulat biru = perintah, persegi biru = petunjuk."}, {"id": "product_alur_stage", "label": "Alur Stage", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "intro -> walk -> crossroad -> materi/kuis -> home. Setiap kali anak berhenti di rambu, dunia berhenti (mode stopped), rambu menjadi tombol yang bisa difokus dan diketuk."}, {"id": "product_enam_rambu", "label": "Enam Rambu", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enam rambu (anak, zebra, dilarang-masuk, belok-kiri, hati-hati, dilarang-parkir), tiga per perjalanan diacak per seed. Urutan tidak boleh dihafal: run.ts mengacak dari seed dan menghindari rambu terakhir yang barusan dilihat. Tiap rambu membawa name, meaning, tip, dan visual; visual tidak memuat nama/arti karena itu jawaban kuis."}, {"id": "product_skor_bintang", "label": "Skor Bintang, Tidak Pernah Gagal", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anak tidak pernah gagal: skor 0 tetap pulang dengan Bintang 1 dan kalimat penyemangat. Tiap soal punya why yang tampil setelah dijawab - penjelasan, bukan hukuman."}, {"id": "product_non_goal", "label": "Non-goal Produk", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio dibatalkan; tidak ada deploy, akun, progres server, atau leaderboard; tidak ada animasi realistis/3D; tidak ada perspektif untuk langit; tidak ada aset raster - semua gambar SVG inline."}, {"id": "product_b1_persimpangan", "label": "B1: Persimpangan Belum Terbaca", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tiga papan terasa 'ditempel', belum terbaca sebagai perempatan; dugaan: jalan samping poligon kasar dan belum ada arti kedalaman. Berkas: src/Junction.tsx, junction.css."}, {"id": "product_utang_verifikasi", "label": "Utang Verifikasi", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass visual di HP sungguhan belum pernah, FPS belum diukur (node sudah menyentuh plafon 30), Firefox baru dirender sekali. Semua bukti berasal dari Chromium headless 360x640 / 360x800 / 390x844 / 1024x600 / 1280x800."}], "edges": [{"source": "product_petualangan_rambu", "target": "product_tujuan_belajar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_petualangan_rambu", "target": "product_audiens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_tujuan_belajar", "target": "product_bentuk_warna", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_tujuan_belajar", "target": "product_audiens", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_bentuk_warna", "target": "product_enam_rambu", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_alur_stage", "target": "product_enam_rambu", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_alur_stage", "target": "product_skor_bintang", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_skor_bintang", "target": "product_tujuan_belajar", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_non_goal", "target": "design_art_aturan", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_b1_persimpangan", "target": "product_alur_stage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_utang_verifikasi", "target": "agents_empat_viewport_tiga_waktu", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_enam_rambu", "target": "agents_determinisme_mulberry32", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_bentuk_warna", "target": "ref_bahan_ajar_yuk_kenali_rambu_lalu_lintas_rambu_larangan", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_bentuk_warna", "target": "ref_bahan_ajar_yuk_kenali_rambu_lalu_lintas_rambu_peringatan", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_enam_rambu", "target": "ref_bahan_ajar_yuk_kenali_rambu_lalu_lintas_rambu_larangan", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_enam_rambu", "target": "ref_bahan_ajar_yuk_kenali_rambu_lalu_lintas_zebra_cross", "relation": "conceptually_rel