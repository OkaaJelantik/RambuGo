{"nodes": [{"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_rencana_scene_berjalan_2_5d", "label": "Rencana Implementasi Scene Berjalan 2.5D", "file_type": "document", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scene berjalan diganti karena 'berjalan' dulu hanya tiga lompatan transition, pohon berupa blob radial-gradient, rumah cakrawala span + atap border, dan tepi jalan digambar dengan clip-path sementara objek ditempatkan dengan proyeksi hiperbolik sehingga keduanya tidak pernah cocok; bar desainnya 'hidup dan lucu' ala web interaktif anak, bukan realistis."}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_satu_loop_raf_reducer_murni", "label": "Satu loop rAF + reducer murni stepWorld", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gerak kontinu tanpa setState per frame: loop memanggil reducer murni stepWorld lalu menulis style.transform dari ref, tidak ada pembacaan layout di dalam loop, dan loop berhenti saat tab hidden."}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_satu_tabel_meter", "label": "Satu tabel meter (meters.ts)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Menghapus bug 'anak raksasa, mobil mainan': ukuran objek = meter x pxPerM x depthScale, tanpa clamp/vh/vw atau px literal untuk ukuran objek."}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_framing_trotoar_kiri", "label": "Framing trotoar kiri", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anak harus terlihat di trotoar karena naskah menyebut trotoar tempat paling aman; jalan hanya terlihat sebagian di kanan dan sisi seberang tidak digambar supaya piksel per meter tidak terbagi dan plat rambu tetap terbaca di 360 px."}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_guard_skala_yang_menggigit", "label": "Guard skala yang menggigit (scale.test.ts)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test yang menyentuh tabelnya sendiri itu tautologi; assertion harus menyentuh kotak produksi (propBox/heroBox/vehicleBox/placeProp) atau DOM hasil render, dan setiap guard harus digagalkan oleh minimal satu mutasi."}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_tabel_mutasi_task_14", "label": "Tabel mutasi Task 14", "file_type": "document", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lima mutasi sengaja dirusak (heroBox kembali ke clamp viewport, PROP_ART kembali ke fraksi viewport, lebar mobil 3x, tiang 0,5 m, SIDEWALK_CENTRE digeser) dan masing-masing harus menggagalkan minimal satu assertion bernama; tanpa tabel ini guard kembali jadi klaim tanpa bukti."}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_sign_emphasis_afordansi", "label": "SIGN_EMPHASIS 1,5 sebagai afordansi game", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pelat 0,60 m hanya 44 px di 360x640 sehingga terlalu kecil menjadi fokus, sementara kotak ketuknya dipaksa min-width 56px sehingga lebih besar dari pelat yang terlihat; METERS tidak diubah supaya tabel meter tetap jujur."}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_panel_dialog_bawah", "label": "Panel dialog bawah (DialoguePanel)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_naskah_11_beat_story_ts", "label": "Naskah 11 beat di story.ts", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_kontrak_aksesibilitas_panel", "label": "Kontrak aksesibilitas panel dialog", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live region tidak boleh lahir-mati per beat (wadah aria-live tetap terpasang, hanya teksnya berganti); fokus tidak pernah jatuh ke body; tombol minimal 44 px; panel maksimal 34vh dengan safe-area-inset-bottom dan tidak menutupi rambu."}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_deskripsi_visual_rambu", "label": "Deskripsi visual rambu tanpa membocorkan jawaban", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pembaca layar tidak boleh mendengar teks yang sama dengan opsi jawaban karena anak bisa mencocokkan kata tanpa membaca rambu; deskripsi harus menggambarkan bentuk, warna, dan isi gambar, dan diuji agar tidak memuat teks opsi yang benar secara harfiah."}, {"id": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_reduced_motion_tidak_memakan_narasi", "label": "Reduced motion tidak memakan narasi", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduced motion mematikan animasi, bukan cerita: kalimat leg-* harus tetap tampil walau dunia sudah stopped sejak mount, karena itu wasStoppedRef mulai true agar onStop tidak menimpa beat leg."}], "edges": [{"source": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_rencana_scene_berjalan_2_5d", "target": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_design_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_rencana_scene_berjalan_2_5d", "target": "docs_superpowers_specs_2026_11_07_naskah_cerita_naskah_cerita", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_satu_loop_raf_reducer_murni", "target": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_rencana_scene_berjalan_2_5d", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_satu_tabel_meter", "target": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_framing_trotoar_kiri", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-11-07-walk-scene-2.5d.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_11_07_walk_scene