{"nodes": [{"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_design_spec", "label": "Design Spec Petualangan Rambu Lalu Lintas", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_alur_state_machine_enam_stage", "label": "Alur state machine enam stage", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jalur materi wajib berujung ke kuis (jalan satu arah menuju rumah) sedangkan jalur kuis menyelesaikan perjalanan langsung; perbedaan itu tercermin di layar rumah."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_walk_scene_2_5d", "label": "Scene berjalan 2.5D (7.1)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gerak treadmill: kamera tidak pernah berpindah dan hero tidak berjalan di layar; yang bergerak adalah dunianya, jadi anak merasa berjalan karena jalan datang ke arahnya."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_pita_lajur_empat", "label": "Empat pita lajur trotoar", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trotoar 2,0 m dipakai sebagai pita, bukan 'boleh di mana saja': jalur anak -0,90, tepi taman -1,85, taman <= -2,30, kerb -0,50..+0,30."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_satu_tabel_meter", "label": "Satu tabel meter (METERS + pxAt)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Satu meter harus berarti sama untuk anak, mobil, dan rambu; tanpa itu 'rumah 6,5 m' cuma klaim. Tinggi mobil/motor sengaja bukan kolom tabel karena mengikuti aspek art supaya roda tidak terpipihkan."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_guard_skala_9_2", "label": "Guard skala 9.2 dan batasnya", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lima mutasi membuktikan jalur sizing produksi (heroBox/propBox/placeProp/placeVehicle/signPlatePx), bukan penempatan hero/rambu di JSX maupun z-index CSS; perubahan left/top atau urutan lapisan belum tertangkap guard dan harus diperiksa dengan tangkapan/rect di peramban."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_lembar_arti_rambu", "label": "Lembar arti rambu / SignSheet (7.2)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lembar memakai baris obrolan dengan avatar anak supaya rambu dijelaskan oleh tokoh yang sama; lembar hanya ditutup CTA atau Escape karena di jalur walk menutup berarti maju ke rambu berikutnya dan rambu itu tidak bisa dikunjungi lagi."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_panel_dialog_7_3", "label": "Panel dialog bawah dan naskah (7.3)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Balon di dalam scene dihapus karena menutupi jalan/rambu dan tidak punya tempat untuk dua tombol; panel fixed 34vh memberi ruang tombol tanpa menggeser scene atau plat rambu."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_cerita_tiga_lapis", "label": "Cerita dipisah tiga lapis (data, presentasi, aksi)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data di story.ts, presentasi di DialoguePanel, aksi di App; panel tidak tahu arti aksi sehingga mengubah kalimat cukup di story.ts, bukan di JSX."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_aturan_bentuk_warna", "label": "Aturan bentuk-warna -> jenis rambu", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ini inti materi G2: peringatan segitiga kuning, larangan bulat merah, perintah bulat biru, petunjuk persegi biru; perintah dan petunjuk sama-sama biru dan bentuknya yang membedakan, karena rambu petunjuk di jalan memang biru, bukan hijau."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_t20_t24_reviu_anotasi", "label": "T20-T24 reviu anotasi 2026-11-08", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_keputusan_fase_16", "label": "Keputusan produk 16", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio dicabut bukan ditunda, distribusi lokal saja tanpa tunnel/deploy, mobile-first 1 anak 1 ponsel, uji anak di luar cakupan fase ini, dan framing trotoar kiri menggantikan deskripsi lama 'dua sisi jalan digambar'."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_ambang_bintang_4_2", "label": "Ambang bintang 4/2", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keputusan pedagogis, bukan teknis: 4-5 benar Bintang 3, 2-3 Bintang 2, 0-1 Bintang 1; test hanya mengunci perilaku sekarang supaya perubahan nanti terlihat di diff."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_definition_of_done", "label": "Definition of Done arah A (14)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_t8_font_cdn", "label": "T8 font Fredoka/Nunito dari CDN", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kalau jaringan sekolah memblokir atau lambat, seluruh karakter visual berubah karena dua font ini yang membentuknya; opsi self-host dua woff2 atau fallback yang sudah diuji, dan belum dikerjakan."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_arah_berikutnya", "label": "Tiga arah fase berikutnya (A/B/C)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rekomendasi sisa arah A lalu B: alur dan scene yang sudah ada adalah asetnya, dan cacat font CDN lebih murah ditutup sekarang daripada setelah konten bertambah."}, {"id": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_halte_z_160", "label": "Halte menyapu di belakang rambu (pelat z 160)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pelat dicat di z-index 160 sementara propZ maksimum 100, jadi setiap prop selalu di belakang pelat; itu sebabnya halte 0,80 m dan lampu 4,5 m boleh melintasi kolom rambu."}], "edges": [{"source": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_design_spec", "target": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_rencana_scene_berjalan_2_5d", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_design_spec", "target": "docs_superpowers_specs_2026_11_07_naskah_cerita_naskah_cerita", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-07-petualangan-rambu-lalu-lintas-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_design_spec", "target": "docs_superpowers_specs_2026_11_07_petu