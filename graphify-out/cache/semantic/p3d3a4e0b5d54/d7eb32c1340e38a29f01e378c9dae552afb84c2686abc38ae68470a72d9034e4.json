{"nodes": [{"id": "docs_superpowers_specs_2026_11_08_prd_handoff_prd_handoff", "label": "PRD & Spec Teknis serah-terima", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dokumen historis: sumber kebenaran yang hidup pindah ke AGENTS.md, PRODUCT.md, dan DESIGN.md di akar repo; yang tersisa berguna di sini adalah riwayat keputusan, utang verifikasi, dan catatan proses."}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_scene_2_5d_stabil", "label": "Scene 2.5D trotoar kiri (stabil)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_scenery_kontinu_pool", "label": "Scenery kontinu: pool 10 slot + draw()", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sabuk scenery diganti spawner kontinu untuk menghapus pengulangan 3,3 detik; pool menukar jenis di dalam slot tetap sehingga tidak ada mount/unmount SVG per objek, dan frame pertama diisi lewat prewarm 6 titik."}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_props_kotak_dimitiki_draw", "label": "Kotak .wk-prop dimiliki draw(), bukan measure()", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pool menukar jenis di dalam satu slot, jadi ukuran yang diukur sekali akan tertinggal satu jenis dari placeProp sehingga objek bergeser dan gepeng; kotak ditulis ulang hanya saat el.dataset.kind berubah."}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_prop_kinds_seeded", "label": "propKinds di-seed dari pool", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kalau state awal null, slot prewarm tampil sebagai div kosong sekitar 1 detik: itulah 'jalan kosong di detik pertama'."}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_trafik_pejalan_deterministik", "label": "Trafik dan pejalan deterministik (5 kendaraan, 3 pejalan)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_rambu_objek_dunia", "label": "Rambu sebagai objek dunia (propZ + signDepth)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rambu datang dari horizon, berhenti di kedalaman 0,22, lalu dilewati, dan diurutkan menurut kedalaman seperti objek lain alih-alih memakai z tetap 160 supaya pejalan atau tiang yang lebih dekat menutupinya dengan benar."}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_sign_figure_satu_svg", "label": "SignFigure: pelat + tiang satu svg", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pelat dan tiang dulu dua span di dalam flex column; setDisplay menulis display:block sehingga tiang jadi elemen inline, tinggi 300 px diabaikan, dan pelat 'jatuh ke tanah'. Sekarang keduanya satu svg 120 x 462,9 unit sehingga tidak ada keadaan di mana mereka terpisah."}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_junction_2_5d", "label": "Persimpangan 2.5D tiga jalur", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Menggantikan layar datar agar scene tidak terasa keluar dari game; rupanya belum diverifikasi mata manusia dan jalan sampingnya masih poligon kasar (B1)."}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_utang_verifikasi", "label": "Utang verifikasi", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass visual di HP sungguhan belum pernah dilakukan, Firefox hanya dirender sekali dan bukan interaktif, dan FPS perangkat belum diukur; semua bukti visual berasal dari Chromium headless di lima viewport."}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_jebakan_proses", "label": "Jebakan proses dari sesi", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_node_budget", "label": "Anggaran 30 node beranimasi (26 terpakai)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plafon 30 node menjaga 60fps di ponsel; menambah node berarti memangkas node lain, dan anggaran dihitung 8 prop + 8 marka + hero + rambu + 5 kendaraan + 3 pejalan."}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_open_bugs_b1_b6", "label": "Bug terbuka B1-B6", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_prd_handoff_rencana_lanjutan_fase", "label": "Rencana lanjutan fase 1-3", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fase 1 menutup bug yang dilaporkan lebih dulu sebelum fitur baru, fase 2 verifikasi yang belum pernah dilakukan, fase 3 fitur berikutnya (kuis dari rambu yang dilihat, materi dua arah, progres tersimpan)."}], "edges": [{"source": "docs_superpowers_specs_2026_11_08_prd_handoff_prd_handoff", "target": "docs_superpowers_specs_2026_11_07_petualangan_rambu_lalu_lintas_design_design_spec", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_08_prd_handoff_prd_handoff", "target": "docs_superpowers_specs_2026_11_08_prd_handoff_utang_verifikasi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_08_prd_handoff_prd_handoff", "target": "docs_superpowers_specs_2026_11_08_prd_handoff_scenery_kontinu_pool", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_08_prd_handoff_scene_2_5d_stabil", "target": "docs_superpowers_plans_2026_11_07_walk_scene_2_5d_framing_trotoar_kiri", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/specs/2026-11-08-prd-handoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_08